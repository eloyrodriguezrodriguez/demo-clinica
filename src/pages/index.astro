---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import Confianza from "../components/sections/Confianza.astro";
import SobreNosotros from "../components/sections/SobreNosotros.astro";
import Especialidades from "../components/sections/Especialidades.astro";
import Equipo from "../components/sections/Equipo.astro";
import Resenas from "../components/sections/Resenas.astro";
import Cita from "../components/sections/Cita.astro";
---

<BaseLayout>
  <!-- Pantalla 1: hero + franja de confianza, juntos ocupan la pantalla -->
  <div class="pantalla">
    <Hero />
    <Confianza />
  </div>

  <!-- Pantalla 2 · fondo claro -->
  <SobreNosotros />

  <!-- Pantalla 3 · fondo azul · se queda fija mientras entran las tarjetas -->
  <Especialidades />

  <!-- Pantalla 4 · fondo claro · se queda fija mientras pasan los profesionales -->
  <Equipo />

  <!-- Pantalla 5 · fondo azul · carrusel 3D de reseñas -->
  <Resenas />

  <!-- Pantalla 6 · fondo claro · formulario de cita -->
  <Cita />
</BaseLayout>