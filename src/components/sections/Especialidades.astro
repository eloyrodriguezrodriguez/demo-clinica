---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import Contenedor from "../ui/Contenedor.astro";
import { negocio } from "../../data/negocio";

const { especialidades, cta } = negocio;
---

<section
  id="especialidades"
  class="especialidades pantalla"
  aria-labelledby="especialidades-titulo"
>
  <Contenedor>
    <div class="especialidades-cabecera">
      <span class="etiqueta">{especialidades.etiqueta}</span>
      <h2 id="especialidades-titulo">{especialidades.titulo}</h2>
    </div>

    <div class="especialidades-lista">
      {especialidades.lista.map((esp) => (
        <article class="especialidad">
          <div class="especialidad-media">
            <Image
              src={esp.imagen}
              alt={esp.alt}
              widths={[400, 640]}
              sizes="(min-width: 768px) 33vw, 100vw"
              class="especialidad-imagen"
            />
          </div>

          <h3 class="especialidad-titulo">{esp.titulo}</h3>
          <p class="especialidad-texto">{esp.texto}</p>

          <ul class="especialidad-motivos">
            {esp.motivos.map((motivo) => (
              <li>
                <Icon
                  name="tabler:check"
                  size={18}
                  aria-hidden="true"
                  class="especialidad-check"
                />
                {motivo}
              </li>
            ))}
          </ul>

          <a href={cta.href} class="enlace especialidad-enlace">
            Pedir cita
          </a>
        </article>
      ))}
    </div>
  </Contenedor>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Lee la altura de la navbar desde el CSS (--altura-header) en píxeles
  const alturaHeader = () =>
    parseFloat(
      getComputedStyle(document.documentElement).getPropertyValue(
        "--altura-header",
      ),
    ) * 16;

  const mm = gsap.matchMedia();

  mm.add(
    {
      escritorio: "(min-width: 768px)",
      movil: "(max-width: 767px)",
    },
    (contexto) => {
      const { escritorio } = contexto.conditions as { escritorio: boolean };
      console.log(
        "Animación de especialidades activa. ¿Escritorio?",
        escritorio,
      );
      if (escritorio) {
        // La sección se queda fija bajo la navbar y las tarjetas entran con el scroll
        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: ".especialidades",
            start: () => `top ${alturaHeader()}`,
            end: "+=150%",
            scrub: true,
            pin: true,
            invalidateOnRefresh: true,
          },
        });

        tl.from(".especialidad", {
          y: 120,
          opacity: 0,
          stagger: 0.3,
          ease: "none",
        }).from(
          ".especialidad-imagen",
          {
            clipPath: "inset(100% 0% 0% 0%)",
            scale: 1.15,
            stagger: 0.3,
            ease: "none",
          },
          0.1,
        );
      } else {
        // En el móvil las tarjetas van una debajo de otra: cada una entra al aparecer
        gsap.utils.toArray<HTMLElement>(".especialidad").forEach((tarjeta) => {
          gsap.from(tarjeta, {
            y: 60,
            opacity: 0,
            ease: "none",
            scrollTrigger: {
              trigger: tarjeta,
              start: "top 90%",
              end: "top 60%",
              scrub: true,
            },
          });
        });
      }
    },
  );
</script>
